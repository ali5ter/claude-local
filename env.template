# claude-local settings. Copy to ~/.config/claude-local/env (or the path in CLAUDE_LOCAL_CONFIG).
# Flags beat environment variables, which beat this file.

# Ollama server. Leave unset for Ollama on this machine. For a server elsewhere, use the address
# it binds to (OLLAMA_HOST on the server), for example a machine on your LAN or over a VPN.
# OLLAMA_HOST_URL=http://192.168.1.63:11434

# Context window the server runs with (OLLAMA_CONTEXT_LENGTH on the server). Read automatically
# when the server is on this machine; required for a server elsewhere, or 32768 is assumed.
# OLLAMA_CONTEXT_LENGTH=131072

# Model for the session (must be installed on the server: ollama list)
# CLAUDE_LOCAL_MODEL=qwen3.6:35b-a3b-coding

# Second model for --switchable sessions (/model opus): slower, for writing and judgement-heavy work
# CLAUDE_LOCAL_HARD_MODEL=qwen3.8:27b
